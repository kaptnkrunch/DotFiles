{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1
        },
    },
"display": {
    "constants": [
        "\u001b[38;2;0;140;200m󰥳 \u001b[38;2;0;100;200m󰥳 \u001b[38;2;20;80;200m󰥳 \u001b[38;2;60;60;200m󰥳 \u001b[38;2;100;50;200m󰥳 \u001b[38;2;140;40;200m󰥳 \u001b[38;2;170;30;200m󰥳 \u001b[38;2;200;30;180m󰥳 \u001b[38;2;220;30;160m󰥳 \u001b[38;2;230;40;140m󰥳 \u001b[38;2;220;50;170m󰥳 \u001b[38;2;200;60;200m󰥳 \u001b[38;2;180;50;210m󰥳 \u001b[38;2;160;40;220m󰥳 \u001b[38;2;140;30;230m󰥳 \u001b[38;2;120;20;240m󰥳 \u001b[38;2;100;10;250m󰥳 "
    ]
	},
    "modules": [
    {
            "type": "custom",
            "format": "{$1}{$1}{$1}",
            "outputColor": "cyan"
        },
        {
            "type": "custom",
            "format": "┌{$1}{$1}{$1}┐",
            "outputColor": "cyan"
        },
        {
        	"key": "\u001b[38;2;0;140;200m│ ┌────────────── 󰣇 ",
        	"outputColor": "cyan",	
            "type": "custom",
            "format": "\u001b[31mC\u001b[33mr\u001b[32mu\u001b[36mn\u001b[34mc\u001b[35mh\u001b[0m\u001b[36m@\u001b[0m\u001b[31mC\u001b[33ma\u001b[32mc\u001b[36mh\u001b[34my\u001b[35mO\u001b[31mS\u001b[33m-\u001b[32mA\u001b[36ms\u001b[34mu\u001b[35ms\u001b[0m",
			"key": "\u001b[38;2;0;140;200m󰣇 ─────────────────────",           
        },
        {
            "type": "host",
            "key": "\u001b[38;2;0;100;200m│ └󰌢   ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;20;80;200m│  ├─ ",
            "keyColor": "cyan"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;60;60;200m│  ├─{icon} ",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;100;50;200m│  └─󰅐 ",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "\u001b[38;2;140;40;200m│ ┌󰻠   ",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;170;30;200m│ └── ",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;200;30;180m│ ┌󰍛   ",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;220;30;160m│ └── ",
            "driverSpecific": true,
            "format": " VRAM:{dedicated-used}/{dedicated-total}"
        },
      	{
         	 "type": "display",
         	 "key": "\u001b[38;2;180;50;210m│  └─󰍹 ",
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;230;40;140m│ ┌   ",
            "keyColor": "cyan"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;220;50;170m│ ├─󰘨  ",
            "keyColor": "cyan"
        },   
        {
            "type": "wm",            
            "key": "\u001b[38;2;200;60;200m│ └─  ",
            "keyColor": "cyan"
        },
        {
		    "type": "shell",
            "key": "\u001b[38;2;160;40;220m│  ├─ ",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;140;30;230m│  ├─ ",
            "keyColor": "cyan"
        },
        {
            "type": "wallpaper",
            "key": "\u001b[38;2;120;20;240m│  ├─󰸉 ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;100;10;250m│  └─󰏖 ",
            "keyColor": "cyan"
        },
        {
            "type": "sound",
            "key": "\u001b[38;2;100;50;200m│ └─󰜟  ",
            "keyColor": "cyan"
        },
        {
            "type": "media",
            "key": "\u001b[38;2;0;100;200m│  └─󰕼 ",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}{$1}┘",
            "outputColor": "cyan"
        },
        {
                "type": "custom",
                "format": "{$1}{$1}{$1}",
                "outputColor": "cyan"
        },
        "break"
    ]
}
